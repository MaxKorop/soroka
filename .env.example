# Token from @BotFather
BOT_TOKEN=

# Private forum-supergroup (negative number, usually -100...) and the "videos" topic id
GROUP_ID=
VIDEOS_TOPIC_ID=

# Neon connection string (keep ?sslmode=require)
DATABASE_URL=postgresql://user:password@ep-xxxx.eu-central-1.aws.neon.tech/neondb?sslmode=require

# Optional: Netscape-format cookies.txt from a secondary Instagram account
COOKIES_FILE=

# Delete the original link message after the video is posted
DELETE_ORIGINAL=false

# Telegram Bot API upload limit (bytes). Leave at 50 MB unless self-hosting the Bot API server.
MAX_VIDEO_BYTES=52428800

TZ=Europe/Kyiv
