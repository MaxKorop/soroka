# Token from @BotFather
BOT_TOKEN=

# Local dev (docker compose -f docker-compose.dev.yml up -d):
DATABASE_URL=postgresql://soroka:soroka@localhost:5432/soroka
# Production (Neon, keep ?sslmode=require):
# DATABASE_URL=postgresql://user:password@ep-xxxx.eu-central-1.aws.neon.tech/neondb?sslmode=require

# Optional: https://www.themoviedb.org/settings/api (v3 API key). Used when /movie_add has no genre.
TMDB_API_KEY=

# Optional: Netscape-format cookies.txt from a secondary Instagram account
COOKIES_FILE=

# Telegram Bot API upload limit (bytes). Leave at 50 MB unless self-hosting the Bot API server.
MAX_VIDEO_BYTES=52428800

# Optional: your Telegram user id. Only the owner can register groups with /setup.
# Leave empty and the first person to run /setup becomes the owner.
OWNER_ID=

# The groups and their topics are NOT configured here: use /setup and /here in Telegram.
